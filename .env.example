DATABASE_URL_DOCS=postgresql:///docs
DATABASE_URL_AUTH=postgresql:///authdb
SESSION_SECRET=<run: python3 -c "import secrets;print(secrets.token_urlsafe(32))">
DOCS_HUB_API_KEY=<run: python3 -c "import secrets;print(secrets.token_urlsafe(32))">
COOKIE_SECURE=1
STORE_ROOT=/root/docs-hub/store
# machine-specific — copy real values from /root/CLAUDE.md
CF_ZONE_ID=
ORIGIN_IP=
